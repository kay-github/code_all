{
  "name": "quick-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "bun scripts/build.mjs build",
    "build:production": "bun scripts/build.mjs production",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test",
    "smoke:production": "bun scripts/production-smoke.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "bun scripts/build.mjs migrate",
    "prisma:migrate:check": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "2.8.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "@babel/core": "7.29.7",
    "defu": "6.1.7",
    "flatted": "3.4.4",
    "undici": "6.28.0"
  }
}
