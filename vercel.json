{
  "functions": { "api/stock.js": { "maxDuration": 60 }, "api/volume.js": { "maxDuration": 30 }, "api/investment-market.js": { "maxDuration": 45 } },
  "routes": [
    {
      "src": "^/(?:admin(?:/.*)?|index\\.html)?$",
      "has": [{ "type": "host", "value": "1.688680.xyz" }],
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/admin(?:/.*)?$",
      "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" },
      "continue": true
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin/index.html"
    },
    {
      "src": "^/iframe/?$",
      "has": [{ "type": "host", "value": "b.688680.xyz" }],
      "dest": "/tools/work-portal/iframe.html"
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "b2.688680.xyz" }],
      "dest": "/tools/work-portal/houtai.html"
    },
    {
      "src": "^/houtai/?$",
      "has": [{ "type": "host", "value": "b.688680.xyz" }],
      "dest": "/tools/work-portal/houtai.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "b.688680.xyz"
        }
      ],
      "dest": "/tools/work-portal/index.html"
    },
    {
      "src": "^/gjd(?:/index\\.html)?/?$",
      "dest": "/tools/national-team-etf/index.html"
    },
    {
      "src": "^(/notes(?:/.*)?)$",
      "has": [{ "type": "host", "value": "1.688680.xyz" }],
      "dest": "https://myapp-note.vercel.app$1"
    },
    {
      "src": "^/gjd/cycle(?:\\.html)?/?$",
      "dest": "/tools/national-team-etf/cycle.html"
    },
    {
      "src": "^/(?:tools/typo-proofreader(?:/.*)?|cbz/?|shooter(?:\\.html)?/?)$",
      "status": 302,
      "headers": { "Location": "/", "Cache-Control": "no-store" }
    },
    {
      "src": "^/api/proofread(?:-monitor)?/?$",
      "status": 410,
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/txdp/?$",
      "dest": "/tools/optical-decline-board/index.html"
    }
  ]
}
