{
  "functions": {
    "api/stock.js": {
      "maxDuration": 60
    },
    "api/volume.js": {
      "maxDuration": 30
    },
    "api/investment-market.js": {
      "maxDuration": 45
    },
    "api/health.js": {
      "maxDuration": 30,
      "includeFiles": "apps/top-radar/**/*.json"
    }
  },
  "schedules": {
    "investment-goals": {
      "schedule": "*/15 * * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/investment-scheduled/goal-alerts",
      "requestMethod": "POST"
    },
    "investment-crowding": {
      "schedule": "20,50 16-18 * * 1-5",
      "timezone": "Asia/Shanghai",
      "path": "/api/investment-scheduled/crowding",
      "requestMethod": "POST"
    },
    "investment-valuations": {
      "schedule": "20,50 0-1,7-9,15-23 * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/investment-scheduled/valuations",
      "requestMethod": "POST"
    }
  },
  "routes": [
    {
      "src": "^/(?:admin(?:/.*)?|index\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "1.688680.xyz"
        }
      ],
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/admin(?:/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin/index.html"
    },
    {
      "src": "^/iframe/?$",
      "has": [
        {
          "type": "host",
          "value": "b.688680.xyz"
        }
      ],
      "dest": "/tools/work-portal/iframe.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "b2.688680.xyz"
        }
      ],
      "dest": "/tools/work-portal/houtai.html"
    },
    {
      "src": "^/houtai/?$",
      "has": [
        {
          "type": "host",
          "value": "b.688680.xyz"
        }
      ],
      "dest": "/tools/work-portal/houtai.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "b.688680.xyz"
        }
      ],
      "dest": "/tools/work-portal/index.html"
    },
    {
      "src": "^/gjd(?:/index\\.html)?/?$",
      "dest": "/tools/national-team-etf/index.html"
    },
    {
      "src": "^/333/?$",
      "has": [
        {
          "type": "host",
          "value": "1.688680.xyz"
        }
      ],
      "status": 302,
      "headers": {
        "Location": "/?tool=investment"
      }
    },
    {
      "src": "^(/notes(?:/.*)?)$",
      "has": [
        {
          "type": "host",
          "value": "1.688680.xyz"
        }
      ],
      "dest": "https://myapp-note.vercel.app$1"
    },
    {
      "src": "^/gjd/cycle(?:\\.html)?/?$",
      "dest": "/tools/national-team-etf/cycle.html"
    },
    {
      "src": "^/(?:tools/typo-proofreader(?:/.*)?|cbz/?|shooter(?:\\.html)?/?)$",
      "status": 302,
      "headers": {
        "Location": "/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/api/proofread(?:-monitor)?/?$",
      "status": 410,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/api/investment-scheduled/(goal-alerts|crowding|valuations)/?$",
      "dest": "/api/investment-market?view=$1&scheduled=1"
    },
    {
      "src": "^/api/top-radar/?$",
      "dest": "/api/health?tool=top-radar"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/txdp/?$",
      "dest": "/tools/optical-decline-board/index.html"
    },
    {
      "src": "^/(?:jjhc|fund-dragon-recovery)/?$",
      "dest": "/tools/fund-dragon-recovery/index.html"
    },
    {
      "src": "^/taoding/?$",
      "dest": "/apps/top-radar/index.html"
    },
    {
      "src": "^/taoding/method/?$",
      "dest": "/apps/top-radar/method.html"
    },
    {
      "src": "^/taoding/escape(?:\\.html)?/?$",
      "dest": "/apps/top-radar/escape.html"
    },
    {
      "src": "^/taoding/escape_report\\.html$",
      "dest": "/apps/top-radar/escape_report.html"
    },
    {
      "src": "^/taoding/escape_v6/?$",
      "dest": "/apps/top-radar/escape_v6.html"
    },
    {
      "src": "^/taoding/admin/?$",
      "dest": "/apps/top-radar/admin.html"
    },
    {
      "src": "^/taoding/data/(.*)$",
      "dest": "/apps/top-radar/data/$1",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/waves/?$",
      "dest": "/tools/wave-tracker/index.html"
    },
    {
      "src": "^/trend/?$",
      "dest": "/tools/trend-signals/index.html"
    },
    {
      "src": "^/trends/?$",
      "dest": "/tools/trend-signals/index.html"
    },
    {
      "src": "^/wave/?$",
      "dest": "/tools/trend-signals/main-wave.html"
    },
    {
      "src": "^/main-wave/?$",
      "dest": "/tools/trend-signals/main-wave.html"
    },
    {
      "src": "^/tools/trend-signals/data/(.*)$",
      "dest": "/tools/trend-signals/data/$1",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/pulse/history(?:/|\\.html)?$",
      "dest": "/tools/market-pulse/history.html"
    },
    {
      "src": "^/pulse/?$",
      "dest": "/tools/market-pulse/index.html"
    },
    {
      "src": "^/tools/market-pulse/data/(.*)$",
      "dest": "/tools/market-pulse/data/$1",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/mirror/?$",
      "dest": "/tools/cycle-mirror/index.html"
    },
    {
      "src": "^/cycle-mirror/?$",
      "dest": "/tools/cycle-mirror/index.html"
    },
    {
      "src": "^/tools/cycle-mirror/data/(.*)$",
      "dest": "/tools/cycle-mirror/data/$1",
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ]
}
